---
import SiteSEO from '../components/SiteSEO.astro'
import { NAV_LINKS } from '../data/navLinks.ts'
---

<html lang="es">
  <SiteSEO title={Astro.props.title} description={Astro.props.description} />
  <body class="min-h-screen bg-white text-gray-900">
    <header class="border-b">
      <nav class="mx-auto max-w-5xl px-6 h-14 flex items-center gap-6">
        <a href="/" class="font-semibold">Armando Ochoa</a>
        <ul class="flex items-center gap-4 ml-auto text-sm">
          {NAV_LINKS.map((l) => (<li><a href={l.href} class="hover:underline">{l.label}</a></li>))}
        </ul>
      </nav>
    </header>
    <main>
      <slot />
    </main>
  </body>
</html>
