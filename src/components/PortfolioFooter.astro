---
interface Props {
  lang?: 'es' | 'en';
  profession?: 'web' | 'data';
}

const { lang = 'es', profession = 'web' } = Astro.props;
const today = new Date();

const descriptions = {
  web: {
    es: 'Creando experiencias web modernas y funcionales',
    en: 'Creating modern and functional web experiences'
  },
  data: {
    es: 'Transformando datos en decisiones estratégicas',
    en: 'Transforming data into strategic decisions'
  }
};

const translations = {
  es: {
    copyright: 'Todos los derechos reservados'
  },
  en: {
    copyright: 'All rights reserved'
  }
};

const description = descriptions[profession][lang];
const t = translations[lang];
---

<footer class="main-footer">
  <div class="main-container">
    <div class="main-footer__upper">
      <div class="main-footer__row main-footer__row-1">
        <h2 class="heading heading-sm main-footer__heading-sm">
          <span>Social</span>
        </h2>
        <div class="main-footer__social-cont">
          <a target="_blank" rel="noreferrer" href="https://www.linkedin.com/in/armando-ochoa-data-analyst">
            <img
              class="main-footer__icon"
              src="/assets/png/linkedin-ico.png"
              alt="icon"
            />
          </a>
          <a target="_blank" rel="noreferrer" href="https://github.com/Armando8a-dev">
            <img
              class="main-footer__icon"
              src="/assets/png/github-ico.png"
              alt="icon"
            />
          </a>
        </div>
      </div>
      <div class="main-footer__row main-footer__row-2">
        <h4 class="heading heading-sm text-lt">Armando Ochoa</h4>
        <p class="main-footer__short-desc">
          {description}
        </p>
      </div>
    </div>

    <div class="main-footer__lower">
      &copy; Copyright {today.getFullYear()}. {t.copyright} -
      <a rel="noreferrer" target="_blank" href="https://armandochoa.com"
        >Armando Ochoa</a
      >
    </div>
  </div>
</footer>

