---
// src/components/Contact.astro
import { getTranslations } from '../utils/translations';

const currentLang = Astro.url.pathname.startsWith('/en') ? 'en' : 'es';
const t = getTranslations(currentLang);
---

<section id="contact" class="page-section">
    <div class="container">
        <div class="heading-container">
            <h2 class="heading-main">{t.contact.title}</h2>
            <p class="heading-sub">
                {t.contact.subtitle}
            </p>
        </div>

        <div class="form-container">
            <form action="https://formspree.io/f/mblzlndn" method="POST">
                <div class="form-group">
                    <label for="name" class="form-label">{t.contact.form.name}</label>
                    <input
                        type="text"
                        id="name"
                        name="name"
                        class="form-input"
                        required
                    />
                </div>
                <div class="form-group">
                    <label for="email" class="form-label">{t.contact.form.email}</label>
                    <input
                        type="email"
                        id="email"
                        name="email"
                        class="form-input"
                        required
                    />
                </div>
                <div class="form-group">
                    <label for="message" class="form-label">{t.contact.form.message}</label>
                    <textarea
                        id="message"
                        name="message"
                        rows="5"
                        class="form-input"
                        required></textarea>
                </div>
                <button type="submit" class="btn">{t.contact.form.submit}</button>
            </form>
        </div>
    </div>
</section>

<style>
    .page-section {
        padding: 6rem 0;
        background-color: var(--color-fondo-secundario);
    }
    .container {
        max-width: 1100px;
        width: 90%;
        margin: 0 auto;
    }

    /* --- Títulos --- */
    .heading-container {
        text-align: center;
        margin-bottom: 4rem;
    }
    .heading-main {
        font-size: var(--font-size-xl);
        margin-bottom: 1rem;
    }
    .heading-sub {
        font-size: var(--font-size-md);
        color: var(--color-texto-secundario);
        max-width: 600px;
        margin: 0 auto;
    }

    /* --- Formulario --- */
    .form-container {
        max-width: 700px;
        margin: 0 auto;
        background-color: var(--color-fondo);
        padding: 2.5rem;
        border-radius: 12px;
        box-shadow: 0 4px 15px rgba(0, 0, 0, 0.08);
        border: 1px solid rgba(0, 0, 0, 0.05);
    }
    .form-group {
        margin-bottom: 1.5rem;
    }
    .form-label {
        display: block;
        margin-bottom: 0.5rem;
        font-weight: 600;
        font-size: var(--font-size-sm);
        color: var(--color-texto-principal);
    }
    .form-input {
        width: 100%;
        padding: 0.75rem 1rem;
        border: 2px solid #e2e8f0;
        border-radius: 8px;
        font-size: var(--font-size-md);
        font-family: inherit;
        background-color: #fff;
        color: var(--color-texto-principal);
        transition: border-color 0.3s ease, box-shadow 0.3s ease;
    }
    .form-input:focus {
        outline: none;
        border-color: var(--color-primario);
        box-shadow: 0 0 0 3px rgba(66, 153, 225, 0.1);
    }

    /* --- Botón --- */
    .btn {
        display: block;
        width: 100%;
        padding: 0.875rem 1.5rem;
        background: var(--color-texto-principal);
        color: #fff;
        text-decoration: none;
        border: none;
        border-radius: 8px;
        font-weight: 700;
        font-size: var(--font-size-md);
        cursor: pointer;
        transition: all 0.3s ease;
    }
    .btn:hover {
        background-color: #3182ce;
        transform: translateY(-2px);
        box-shadow: 0 4px 12px rgba(66, 153, 225, 0.3);
    }
</style>
