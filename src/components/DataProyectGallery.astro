---
// src/components/DataProjectGallery.astro
interface Project {
  title: string;
  description: string;
  image: string;
  tableauUrl: string;
}

const projects: Project[] = [
  {
    title: 'Customer Segmentation Dashboard',
    description: 'Análisis RFM y clustering K-Means para segmentación de clientes',
    image: '/thumbs/customer-segmentation.jpg',
    tableauUrl: 'https://public.tableau.com/views/CustomerSegmentation_123456'
  },
  {
    title: 'Sales Performance Analysis',
    description: 'KPIs de ventas por región, producto y temporada',
    image: '/thumbs/sales-performance.jpg',
    tableauUrl: 'https://public.tableau.com/views/SalesPerformance_789012'
  },
  {
    title: 'Financial Metrics Dashboard',
    description: 'Visualización de márgenes, ingresos y proyecciones financieras',
    image: '/thumbs/financial-metrics.jpg',
    tableauUrl: 'https://public.tableau.com/views/FinancialMetrics_345678'
  },
];
---

<section class="data-gallery">
  <div class="container">
    <div class="gallery-header">
      <h2>Proyectos de Análisis de Datos</h2>
      <p>Transformando datos en insights visuales con Python, SQL y Tableau</p>
    </div>

    <div class="projects-grid">
      {projects.map((project) => (
        <a
          href={project.tableauUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="project-card"
        >
          <img src={project.image} alt={project.title} class="project-image" />
          <div class="project-overlay">
            <h3>{project.title}</h3>
            <p>{project.description}</p>
            <span class="view-link">Ver Dashboard →</span>
          </div>
        </a>
      ))}
    </div>
  </div>
</section>

<style>
  .data-gallery {
    padding: 6rem 0;
    background: linear-gradient(135deg, #f8f9fa 0%, #e3f2fd 100%);
  }

  .container {
    max-width: 1200px;
    width: 90%;
    margin: 0 auto;
  }

  .gallery-header {
    text-align: center;
    margin-bottom: 4rem;
  }

  .gallery-header h2 {
    font-size: 2.5rem;
    font-weight: 700;
    color: var(--color-texto-principal);
    margin-bottom: 1rem;
  }

  .gallery-header p {
    font-size: 1.1rem;
    color: var(--color-texto-secundario);
    max-width: 600px;
    margin: 0 auto;
  }

  .projects-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(320px, 1fr));
    gap: 2rem;
  }

  .project-card {
    position: relative;
    overflow: hidden;
    border-radius: 12px;
    box-shadow: 0 4px 20px rgba(0, 0, 0, 0.1);
    aspect-ratio: 16 / 9;
    display: block;
    text-decoration: none;
    transition: transform 0.3s ease, box-shadow 0.3s ease;
  }

  .project-card:hover {
    transform: translateY(-8px);
    box-shadow: 0 12px 30px rgba(0, 0, 0, 0.15);
  }

  .project-image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.5s ease;
  }

  .project-card:hover .project-image {
    transform: scale(1.1);
  }

  .project-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(to top, rgba(0, 0, 0, 0.85) 0%, rgba(0, 0, 0, 0.4) 50%, transparent 100%);
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    padding: 1.5rem;
    opacity: 0;
    transition: opacity 0.3s ease;
  }

  .project-card:hover .project-overlay {
    opacity: 1;
  }

  .project-overlay h3 {
    color: white;
    font-size: 1.25rem;
    font-weight: 700;
    margin: 0 0 0.5rem 0;
    transform: translateY(20px);
    transition: transform 0.3s ease;
  }

  .project-card:hover .project-overlay h3 {
    transform: translateY(0);
  }

  .project-overlay p {
    color: rgba(255, 255, 255, 0.9);
    font-size: 0.9rem;
    margin: 0 0 1rem 0;
    line-height: 1.5;
    transform: translateY(20px);
    transition: transform 0.3s ease 0.05s;
  }

  .project-card:hover .project-overlay p {
    transform: translateY(0);
  }

  .view-link {
    color: #64b5f6;
    font-size: 0.9rem;
    font-weight: 600;
    transform: translateY(20px);
    transition: transform 0.3s ease 0.1s;
  }

  .project-card:hover .view-link {
    transform: translateY(0);
  }

  @media (max-width: 768px) {
    .gallery-header h2 {
      font-size: 2rem;
    }
    .projects-grid {
      grid-template-columns: 1fr;
    }
  }
</style>