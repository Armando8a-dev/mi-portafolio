---
// Componente para proyectos de Data Analyst - Diseño visual con imagen principal
interface Props {
  title: string;
  description: string;
  image?: string;
  tableauUrl: string;
  tags?: string[];
  lang?: 'es' | 'en';
}

const { title, description, image, tableauUrl, tags = [], lang = 'es' } = Astro.props;

const translations = {
  es: { viewProject: 'Clic para ver' },
  en: { viewProject: 'Click to view' }
};

const t = translations[lang];
---

<a 
  href={tableauUrl} 
  target="_blank" 
  rel="noopener noreferrer" 
  class="project-card"
>
  {image && (
    <div class="project-card__image-wrapper">
      <img src={image} alt={title} class="project-card__image" />
    </div>
  )}
  
  <div class="project-card__overlay">
    <div class="project-card__content">
      <h3 class="project-card__title">{title}</h3>
      <p class="project-card__description">{description}</p>
      <span class="project-card__cta">{t.viewProject}</span>
    </div>
  </div>
</a>

<style>
  :root {
    --accent-color: #0062b9;
    --overlay-bg: rgba(0, 15, 35, 0.92);
  :root {
    --accent-color: #0062b9;
    --overlay-bg: rgba(0, 15, 35, 0.92);
    --text-white: #ffffff;
    --shadow-sm: 0 4px 12px rgba(0, 0, 0, 0.08);
    --shadow-lg: 0 12px 40px rgba(0, 0, 0, 0.15);
  }

  .project-card {
    position: relative;
    display: block;
    height: 100%;
    min-height: 400px;
    border-radius: 16px;
    overflow: hidden;
    box-shadow: var(--shadow-sm);
    transition: all 0.4s cubic-bezier(0.4, 0, 0.2, 1);
    text-decoration: none;
    cursor: pointer;
  }

  .project-card:hover {
    transform: translateY(-8px);
    box-shadow: var(--shadow-lg);
  }

  /* --- Imagen principal (siempre visible) --- */
  .project-card__image-wrapper {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    z-index: 1;
  }

  .project-card__image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.6s cubic-bezier(0.4, 0, 0.2, 1);
  }

  .project-card:hover .project-card__image {
    transform: scale(1.08);
  }

  /* --- Overlay con contenido (aparece al hover) --- */
  .project-card__overlay {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    background: var(--overlay-bg);
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 3rem;
    opacity: 0;
    transition: opacity 0.4s ease;
    z-index: 2;
  }

  .project-card:hover .project-card__overlay {
    opacity: 1;
  }

  .project-card__content {
    text-align: center;
    color: var(--text-white);
    transform: translateY(20px);
    transition: transform 0.4s cubic-bezier(0.4, 0, 0.2, 1);
  }

  .project-card:hover .project-card__content {
    transform: translateY(0);
  }

  .project-card__title {
    font-size: 2.2rem;
    font-weight: 700;
    color: var(--text-white);
    margin: 0 0 1.5rem 0;
    line-height: 1.2;
    letter-spacing: -0.02em;
  }

  .project-card__description {
    font-size: 1.15rem;
    color: rgba(255, 255, 255, 0.9);
    line-height: 1.6;
    margin: 0 0 1.5rem 0;
    max-width: 90%;
    margin-left: auto;
    margin-right: auto;
  }

  .project-card__cta {
    display: inline-block;
    color: #ffffff;
    font-size: 1rem;
    font-weight: 500;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    opacity: 0.9;
    transition: opacity 0.3s ease;
  }

  .project-card:hover .project-card__cta {
    opacity: 1;
  }

  /* Responsivo */
  @media (max-width: 768px) {
    .project-card {
      min-height: 350px;
    }

    .project-card__overlay {
      padding: 2rem;
    }

    .project-card__title {
      font-size: 1.9rem;
      margin-bottom: 1.2rem;
    }

    .project-card__description {
      font-size: 1.05rem;
      margin-bottom: 1.5rem;
    }

    .project-card__cta {
      padding: 0.8rem 2rem;
      font-size: 1rem;
    }
  }

  @media (max-width: 480px) {
    .project-card {
      min-height: 320px;
    }

    .project-card__overlay {
      padding: 1.5rem;
    }

    .project-card__title {
      font-size: 1.7rem;
    }

    .project-card__description {
      font-size: 1rem;
    }
  }
</style>
