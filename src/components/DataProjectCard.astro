---
// src/components/DataProjectCard.astro
interface Props {
  title: string;
  problem: string;
  approach: string;
  impact: string;
  tags: string[];
  repoLink: string;
  dashboardLink?: string;
}
const { title, problem, approach, impact, tags, repoLink, dashboardLink } = Astro.props;
---

<div class="data-card">
  <h3>{title}</h3>
  <div class="card-section">
    <strong>Problema:</strong> <p>{problem}</p>
  </div>
  <div class="card-section">
    <strong>Enfoque:</strong> <p>{approach}</p>
  </div>
  <div class="card-section impact">
    <strong>Impacto:</strong> <p>{impact}</p>
  </div>
  <div class="tags">
    {tags.map(tag => <span class="tag">{tag}</span>)}
  </div>
  <div class="card-footer">
    <a href={repoLink} target="_blank" rel="noopener noreferrer">Ver Repo →</a>
    {dashboardLink && <a href={dashboardLink} target="_blank" rel="noopener noreferrer">Dashboard →</a>}
  </div>
</div>

<style>
  .data-card {
    background: var(--color-fondo-secundario);
    border-radius: 8px;
    padding: 1.5rem;
    box-shadow: 0 4px 15px rgba(0, 0, 0, 0.05);
    transition: transform 0.3s;
  }
  .data-card:hover {
    transform: translateY(-5px);
  }
  h3 {
    font-size: 1.25rem;
    margin-bottom: 1rem;
  }
  .card-section {
    margin-bottom: 1rem;
  }
  .card-section strong {
    display: block;
    font-size: 0.9rem;
    color: var(--color-primario);
    margin-bottom: 0.25rem;
  }
  .card-section p {
    font-size: 0.9rem;
    margin: 0;
  }
  .impact p {
    font-weight: 600;
    color: var(--color-texto-principal);
  }
  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin: 1rem 0;
  }
  .tag {
    background: rgba(66, 153, 225, 0.1);
    color: var(--color-primario);
    padding: 0.25rem 0.75rem;
    border-radius: 9999px;
    font-size: 0.75rem;
  }
  .card-footer {
    display: flex;
    gap: 1rem;
  }
  .card-footer a {
    color: var(--color-primario);
    font-weight: 600;
    text-decoration: none;
  }
</style>