---
// src/components/LanguageSelector.astro
const currentPath = Astro.url.pathname;
const currentLang = currentPath.startsWith('/en') ? 'en' : 'es';

// Generar la URL del idioma alternativo
const getAlternativeUrl = () => {
  if (currentLang === 'es') {
    return currentPath === '/' ? '/en' : `/en${currentPath}`;
  } else {
    return currentPath.replace('/en', '') || '/';
  }
};

const alternativeUrl = getAlternativeUrl();
---

<div class="language-selector">
  <a href={alternativeUrl} class="lang-toggle" aria-label={currentLang === 'es' ? 'Switch to English' : 'Cambiar a Español'}>
    <svg class="globe-icon" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
      <circle cx="12" cy="12" r="10"></circle>
      <line x1="2" y1="12" x2="22" y2="12"></line>
      <path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"></path>
    </svg>
    <span class="lang-text">{currentLang === 'es' ? 'EN' : 'ES'}</span>
  </a>
</div>

<style>
  .language-selector {
    display: flex;
    align-items: center;
  }

  .lang-toggle {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    padding: 0.6rem 1.2rem;
    background: var(--color-fondo-secundario, #ffffff) !important;
    border: 2px solid var(--color-texto-principal, #2d3748) !important;
    border-radius: 50px;
    cursor: pointer;
    font-weight: 600;
    color: var(--color-texto-principal, #2d3748) !important;
    text-decoration: none !important;
    transition: all 0.3s ease;
    box-shadow: 0 2px 4px rgba(45, 55, 72, 0.1);
    font-size: 0.9rem;
  }

  .lang-toggle:hover {
    transform: translateY(-2px) !important;
    box-shadow: 0 4px 8px rgba(45, 55, 72, 0.2) !important;
    background: var(--color-texto-principal, #2d3748) !important;
    color: white !important;
    border-color: var(--color-texto-principal, #2d3748) !important;
  }

  .lang-toggle:hover .globe-icon {
    stroke: white !important;
  }

  .lang-toggle:active {
    transform: translateY(0);
  }

  .globe-icon {
    width: 18px;
    height: 18px;
    stroke-width: 2.5;
    transition: stroke 0.3s ease;
  }

  .lang-text {
    font-size: 0.875rem;
    font-weight: 700;
    letter-spacing: 0.5px;
  }

  @media (max-width: 768px) {
    .lang-toggle {
      padding: 0.4rem 0.9rem;
      gap: 0.3rem;
    }

    .globe-icon {
      width: 15px;
      height: 15px;
    }

    .lang-text {
      font-size: 0.75rem;
    }
  }

  @media (max-width: 480px) {
    .lang-toggle {
      padding: 0.35rem 0.7rem;
      gap: 0.25rem;
    }
    
    .globe-icon {
      width: 16px;
      height: 16px;
    }
    
    .lang-text {
      font-size: 0.7rem;
    }
  }
</style>
