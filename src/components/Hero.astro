---
// src/components/Hero.astro
import { getTranslations } from '../utils/translations';

const currentLang = Astro.url.pathname.startsWith('/en') ? 'en' : 'es';
const t = getTranslations(currentLang);
---

<section class="hero">
  <div class="hero-content">
    <h1 class="title">{t.hero.greeting}</h1>
    <p class="description">
      {t.hero.description}
    </p>
  </div>
  <div class="scroll-indicator">
    <div class="mouse"></div>
  </div>
</section>

<style>
  .hero {
    padding: 6rem 2rem;
    position: relative;
    text-align: center;
    background-color: var(--color-fondo);
  }

  .hero-content {
    max-width: 1000px;
    margin: 0 auto;
  }

  .title {
    font-size: clamp(2.2em, 8vw, 4rem);
    color: var(--color-texto-principal);
    margin: 0 0 1.5rem 0;
  }

  .description {
    font-size: 1.1rem;
    color: var(--color-texto-secundario);
    line-height: 1.7;
    margin: 0;
  }

  /* --- Animación del Mouse --- */
  .scroll-indicator {
    position: absolute;
    bottom: 2rem;
    left: 50%;
    transform: translateX(-50%);
  }

  .mouse {
    width: 25px;
    height: 40px;
    border: 2px solid var(--color-texto-secundario);
    border-radius: 60px;
    position: relative;
  }

  .mouse::before {
    content: "";
    width: 5px;
    height: 5px;
    position: absolute;
    top: 7px;
    left: 50%;
    transform: translateX(-50%);
    background-color: var(--color-texto-secundario);
    border-radius: 50%;
    opacity: 1;
    animation: wheel 1.5s infinite;
  }

  @keyframes wheel {
    from {
      opacity: 1;
      top: 7px;
    }
    to {
      opacity: 0;
      top: 25px;
    }
  }
</style>
