---
import Layout from '../layouts/Layout.astro';
import DataProjectGallery from '../components/DataProyectGallery.astro';
---

<Layout 
  title="Análisis de Datos - Armando Ochoa" 
  description="Proyectos de análisis de datos con Python, SQL, Power BI y Tableau."
>
  <section class="hero-data bg-gradient-to-br from-blue-50 to-indigo-100 py-20">
    <div class="max-w-4xl mx-auto text-center px-4">
      <h1 class="text-5xl font-bold text-gray-800 mb-6">Análisis de Datos</h1>
      <p class="text-xl text-gray-600">
        Transformo datos en insights accionables mediante Python, SQL, Tableau y storytelling efectivo.
      </p>
    </div>
  </section>

  <!-- Galería Visual de Proyectos -->
  <DataProjectGallery />
</Layout>

<style>
  .hero-data {
    padding: 6rem 0 4rem;
    text-align: center;
  }
  .container {
    max-width: 1100px;
    width: 90%;
    margin: 0 auto;
  }
  h1 {
    font-size: var(--font-size-xl);
    margin-bottom: 1rem;
  }
  .section-title {
    font-size: var(--font-size-xl);
    text-align: center;
    margin-bottom: 3rem;
  }
  .projects-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(320px, 1fr));
    gap: 2rem;
  }
</style>