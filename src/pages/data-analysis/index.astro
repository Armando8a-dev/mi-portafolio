---
import Layout from '../../layouts/Layout.astro'
import DataProjectCard from '../../components/DataProjectCard.astro'

const projects = [
  {
    title: 'Customer Segmentation (K-Means + RFM)',
    context: 'Segmentación de clientes para marketing orientado por valor y frecuencia.',
    approach: 'EDA con Pandas, RFM, K-Means, silhouette score.',
    impact: '4 segmentos; potencial +12% conversión dirigida.',
    tags: ['Python','Pandas','Scikit-learn','Matplotlib'],
    repoUrl: 'https://github.com/Armando8a-dev/customer-segmentation-data',
    demoUrl: '',
  },
  {
    title: 'Churn Prediction (Logistic/Tree)',
    context: 'Detección temprana de usuarios con alta probabilidad de abandono.',
    approach: 'Limpieza, encoding, class weights, ROC-AUC/PR.',
    impact: 'AUC 0.84; priorización de retención en top 20% riesgo.',
    tags: ['Python','Scikit-learn','Imbalanced-learn','SQL'],
    repoUrl: 'https://github.com/Armando8a-dev/churn-prediction',
    demoUrl: '',
  },
  {
    title: 'Financial Dashboard (Power BI)',
    context: 'KPIs de ingresos/margen por región con slicers y targets.',
    approach: 'Modelo de datos limpio + DAX para periodos móviles.',
    impact: 'Tiempo de reporte -18%; claridad en KPIs.',
    tags: ['Power BI','DAX','Data Modeling'],
    repoUrl: 'https://github.com/Armando8a-dev/financial-visualization-data',
    demoUrl: 'https://app.powerbi.com/',
  },
]

---

<Layout title="Data Analysis" description="Proyectos de análisis con Python/SQL/Power BI">
  <section class="mx-auto max-w-5xl px-6 py-16">
    <header class="text-center mb-12">
      <h1 class="text-4xl font-bold">Data Analysis</h1>
      <p class="mt-3 text-base text-gray-600">Análisis con Python, SQL, Power BI y storytelling con datos.</p>
    </header>

    <div class="grid gap-6 sm:grid-cols-2">
      {projects.map((p) => (<DataProjectCard {...p} />))}
    </div>
  </section>
</Layout>
