---
// src/pages/web-developer.astro
import Layout from "../layouts/Layout.astro";
import Projects from "../components/Projects.astro";
import Contact from "../components/Contact.astro";
import { getTranslations } from '../utils/translations';

const currentLang = Astro.url.pathname.startsWith('/en') ? 'en' : 'es';
const t = getTranslations(currentLang);
---

<Layout title="Armando Ochoa - Desarrollador Web">
  <main>
    <!-- Hero Section -->
    <section class="hero">
      <div class="hero-content">
        <h1 class="title">{t.pages.webDeveloper.title}</h1>
        <p class="description">
          {t.pages.webDeveloper.description}
        </p>
        <a href="/" class="btn-back">{t.pages.webDeveloper.backHome}</a>
      </div>
    </section>

    <!-- Proyectos -->
    <Projects />

    <!-- Contacto -->
    <Contact />
  </main>
</Layout>

<style>
  .hero {
    padding: 6rem 2rem;
    text-align: center;
    background-color: var(--color-fondo-secundario);
  }

  .hero-content {
    max-width: 1000px;
    margin: 0 auto;
  }

  .title {
    font-size: clamp(2rem, 6vw, 3.5rem);
    color: var(--color-texto-principal);
    margin: 0 0 1.5rem 0;
    font-weight: 700;
  }

  .description {
    font-size: 1.1rem;
    color: var(--color-texto-secundario);
    line-height: 1.7;
    margin: 0 0 2rem 0;
    max-width: 800px;
    margin-left: auto;
    margin-right: auto;
  }

  .btn-back {
    display: inline-block;
    padding: 0.875rem 2rem;
    background-color: var(--color-primario);
    color: white;
    text-decoration: none;
    border-radius: 6px;
    font-weight: 600;
    font-size: var(--font-size-md);
    transition: all 0.3s ease;
    margin-top: 1rem;
  }

  .btn-back:hover {
    transform: scale(1.05);
    box-shadow: 0 6px 20px rgba(66, 153, 225, 0.3);
    background-color: #3182ce;
  }
</style>
