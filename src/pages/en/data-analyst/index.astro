---
import Layout from "../../../layouts/PortfolioLayout.astro";
import Header from "../../../components/PortfolioHeader.astro";
import Footer from "../../../components/PortfolioFooter.astro";
import ProjectGalleryCard from "../../../components/ProjectGalleryCard.astro";
import SkillIcon from "../../../components/SkillIcon.astro";
---

<Layout
  title="Armando Ochoa - DA"
  description="Portfolio de Data Analyst - Armando Ochoa"
  favicon="📊"
>
  <Header currentPath="/en/data-analyst" />

  <section class="home-hero">
    <div class="home-hero__content">
      <h1 class="heading-primary">HI, I'M ARMANDO OCHOA</h1>
      <div class="home-hero__info">
        <p class="text-primary">
          My professional focus is data analysis and interpretation to generate
          business strategies. I dedicate myself to discovering patterns in
          information and visualizing them effectively so that decision-making
          is always agile and evidence-based.
        </p>
      </div>
    </div>

    <div class="home-hero__mouse-scroll-cont">
      <div class="mouse"></div>
    </div>
  </section>

  <section id="about" class="about sec-pad">
    <div class="main-container">
      <h2 class="heading heading-sec heading-sec__mb-med">
        <span class="heading-sec__main">About Me</span>
        <span class="heading-sec__sub">
          Here you'll find more information about me, what I do, and my
          skills.
        </span>
      </h2>
      <div class="about__content">
        <div class="about__content-main">
          <h3 class="about__content-title">Get to know me!</h3>
          <div class="about__content-details">
            <p class="about__content-details-para">
              I'm a <strong>Data Analyst </strong> passionate about uncovering stories
              behind numbers and transforming information into strategic decisions.
              I'm motivated by understanding the "why" behind every piece of data and providing
              real value through analysis, visualization, and interpretation of
              results.
              <br />
              <br />
              During my training, I have developed projects that range from data
              cleaning and transformation to creating interactive dashboards
              with tools like Python, SQL, and Tableau. My approach
              combines analytical thinking with constant curiosity to improve
              processes and optimize decision-making in dynamic environments.
              <br />
              <br />
              I firmly believe that data is the foundation for understanding, improving,
              and growing any business. That's why my goal is to continue perfecting
              my technical and strategic skills to turn information
              into actionable knowledge that drives tangible and sustainable results.
            </p>
          </div>
          <a href="./#contact" class="btn btn--med btn--theme dynamicBgClr"
            >Contact</a
          >
        </div>
        <div class="about__content-skills">
          <h3 class="about__content-title">My Skills</h3>
          <div class="skills-grid">
            <SkillIcon name="Python" icon="simple-icons:python" />
            <SkillIcon name="Pandas" icon="simple-icons:pandas" />
            <SkillIcon name="NumPy" icon="simple-icons:numpy" />
            <SkillIcon name="Tableau" icon="simple-icons:tableau" />
            <SkillIcon name="PostgreSQL" icon="simple-icons:postgresql" />
            <SkillIcon name="MySQL" icon="simple-icons:mysql" />
            <SkillIcon name="Excel" icon="simple-icons:microsoftexcel" />
            <SkillIcon name="Jupyter" icon="simple-icons:jupyter" />
            <SkillIcon name="Plotly" icon="simple-icons:plotly" />
            <SkillIcon name="Scipy" icon="simple-icons:scipy" />
            <SkillIcon name="Matplotlib" icon="simple-icons:python" />
            <SkillIcon name="Seaborn" icon="simple-icons:python" />
            <SkillIcon name="Sklearn" icon="simple-icons:scikitlearn" />
          </div>
        </div>
      </div>
    </div>
  </section>

  <section id="projects" class="projects sec-pad">
    <div class="main-container">
      <h2 class="heading heading-sec heading-sec__mb-bg">
        <span class="heading-sec__main">Analysis Projects</span>
        <span class="heading-sec__sub">
          Explore my dashboards and interactive data visualizations. Click to view each project on Tableau Public.
        </span>
      </h2>

      <div class="projects-gallery">
        <ProjectGalleryCard
          title="Customer Segmentation"
          description="Customer analysis and segmentation using clustering techniques"
          image="/assets/jpeg/project-mockup-example.jpeg"
          tableauUrl="https://github.com/Armando8a-dev/customer-segmentation-data"
          lang="en"
        />

        <ProjectGalleryCard
          title="Financial Visualization"
          description="Interactive dashboard of financial metrics and KPIs"
          image="/assets/jpeg/project-mockup-example.jpeg"
          tableauUrl="https://github.com/Armando8a-dev/financial-visualization-data"
          lang="en"
        />

        <ProjectGalleryCard
          title="Customer Behavior"
          description="Analysis of user patterns and behavior"
          image="/assets/jpeg/project-mockup-example.jpeg"
          tableauUrl="https://github.com/Armando8a-dev/customer-behavior-data"
          lang="en"
        />
      </div>
    </div>
  </section>

  <section id="approach" class="approach sec-pad">
    <div class="main-container">
      <h2 class="heading heading-sec heading-sec__mb-bg">
        <span class="heading-sec__main">My Analytical Approach</span>
        <span class="heading-sec__sub">
          The fundamental pillars that guide my work as a Data Analyst
        </span>
      </h2>

      <div class="approach-grid">
        <div class="approach-card">
          <div class="approach-card__icon">
            <svg xmlns="http://www.w3.org/2000/svg" width="64" height="64" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M3 3v18h18"/>
              <path d="m19 9-5 5-4-4-3 3"/>
            </svg>
          </div>
          <h3 class="approach-card__title">Data Manipulation and Analysis</h3>
          <p class="approach-card__description">
            I specialize in preparing, cleaning, and transforming datasets to obtain reliable and useful information.
            I have worked with Python (Pandas, NumPy) and SQL to identify patterns, debug inconsistencies, and generate metrics that facilitate decision-making.
            I aim to continue improving in designing more automated and efficient pipelines.
          </p>
        </div>

        <div class="approach-card">
          <div class="approach-card__icon">
            <svg xmlns="http://www.w3.org/2000/svg" width="64" height="64" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <rect width="18" height="18" x="3" y="3" rx="2"/>
              <path d="M7 7h10"/>
              <path d="M7 12h10"/>
              <path d="M7 17h10"/>
            </svg>
          </div>
          <h3 class="approach-card__title">Data Visualization</h3>
          <p class="approach-card__description">
            I enjoy converting data into visual stories that convey value clearly and attractively.
            I use tools like Tableau to create dashboards focused on business understanding and communication with non-technical teams.
            I continue to strengthen my visual judgment and ability to choose the most effective visualizations according to context.
          </p>
        </div>

        <div class="approach-card">
          <div class="approach-card__icon">
            <svg xmlns="http://www.w3.org/2000/svg" width="64" height="64" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M12 8V4H8"/>
              <rect width="16" height="12" x="4" y="8" rx="2"/>
              <path d="M2 14h2"/>
              <path d="M20 14h2"/>
              <path d="M15 13v2"/>
              <path d="M9 13v2"/>
            </svg>
          </div>
          <h3 class="approach-card__title">Machine Learning</h3>
          <p class="approach-card__description">
            I am developing my skills in predictive models and user segmentation with Python (Scikit-learn).
            I have implemented supervised and unsupervised algorithms in learning projects, analyzing results and interpreting their impact on real decisions.
            My goal is to deepen my understanding of model evaluation and hyperparameter optimization for concrete business cases.
          </p>
        </div>
      </div>
    </div>
  </section>

  <section id="contact" class="contact sec-pad dynamicBg">
    <div class="main-container">
      <h2 class="heading heading-sec heading-sec__mb-med">
        <span class="heading-sec__main heading-sec__main--lt">Contact</span>
        <span class="heading-sec__sub heading-sec__sub--lt">
          Do you have any questions or want to work together? Fill out the
          form and I will get in touch with you as soon as possible.
        </span>
      </h2>
      <div class="contact__form-container">
        <form
          action="https://formspree.io/f/mblzlndn"
          method="POST"
          class="contact__form"
        >
          <div class="contact__form-field">
            <label class="contact__form-label" for="name">Name</label>
            <input
              required
              placeholder="Enter Your Name"
              type="text"
              class="contact__form-input"
              name="name"
              id="name"
            />
          </div>
          <div class="contact__form-field">
            <label class="contact__form-label" for="email">Email</label>
            <input
              required
              placeholder="Enter Your Email"
              type="text"
              class="contact__form-input"
              name="email"
              id="email"
            />
          </div>
          <div class="contact__form-field">
            <label class="contact__form-label" for="message">Message</label>
            <textarea
              required
              cols="30"
              rows="10"
              class="contact__form-input"
              placeholder="Enter Your Message"
              name="message"
              id="message"></textarea>
          </div>
          <button type="submit" class="btn btn--theme contact__btn">
            Send Message
          </button>
        </form>
      </div>
    </div>
  </section>

  <Footer lang="en" profession="data" />
</Layout>

<style>
  /* Carrusel móvil para proyectos */
  .projects-gallery {
    display: flex;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    gap: 1.5rem;
    margin-top: 4rem;
    padding: 0 1.5rem 2rem;
    -webkit-overflow-scrolling: touch;
    scrollbar-width: none; /* Firefox */
    -ms-overflow-style: none; /* IE and Edge */
  }

  /* Ocultar scrollbar */
  .projects-gallery::-webkit-scrollbar {
    display: none; /* Chrome, Safari and Opera */
  }

  .projects-gallery > :global(*) {
    flex: 0 0 85%;
    scroll-snap-align: center;
  }

  @media (min-width: 768px) {
    .projects-gallery {
      display: grid;
      grid-template-columns: repeat(2, 1fr);
      gap: 2rem;
      overflow-x: visible;
      scroll-snap-type: none;
      padding: 0;
    }

    .projects-gallery > :global(*) {
      flex: unset;
      scroll-snap-align: unset;
    }
  }

  @media (min-width: 1024px) {
    .projects-gallery {
      grid-template-columns: repeat(3, 1fr);
      gap: 2.5rem;
    }
  }

  /* Approach Section Styles */
  .approach {
    background: linear-gradient(135deg, #f5f7fa 0%, #e8eef5 100%);
  }

  .approach-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 2.5rem;
    margin-top: 4rem;
  }

  @media (min-width: 768px) {
    .approach-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 1024px) {
    .approach-grid {
      grid-template-columns: repeat(3, 1fr);
      gap: 3rem;
    }
  }

  .approach-card {
    background: white;
    border-radius: 12px;
    padding: 3rem 2.5rem;
    text-align: center;
    box-shadow: 0 4px 20px rgba(0, 0, 0, 0.08);
    transition: all 0.3s ease;
    display: flex;
    flex-direction: column;
    align-items: center;
    height: 100%;
  }

  .approach-card:hover {
    transform: translateY(-8px);
    box-shadow: 0 12px 35px rgba(0, 98, 185, 0.15);
  }

  .approach-card__icon {
    width: 80px;
    height: 80px;
    background: linear-gradient(135deg, #0062b9 0%, #0052a3 100%);
    border-radius: 16px;
    display: flex;
    align-items: center;
    justify-content: center;
    margin-bottom: 2rem;
    transition: all 0.3s ease;
  }

  .approach-card:hover .approach-card__icon {
    transform: scale(1.1) rotate(5deg);
  }

  .approach-card__icon svg {
    color: white;
    width: 40px;
    height: 40px;
  }

  .approach-card__title {
    font-size: 2rem;
    font-weight: 700;
    color: #333;
    margin-bottom: 1.5rem;
    line-height: 1.3;
  }

  @media (max-width: 768px) {
    .approach-card__title {
      font-size: 1.8rem;
    }
  }

  .approach-card__description {
    font-size: 1.6rem;
    color: #666;
    line-height: 1.7;
    text-align: center;
  }

  @media (max-width: 768px) {
    .approach-card__description {
      font-size: 1.5rem;
    }
  }

  @media (max-width: 480px) {
    .approach-card {
      padding: 2.5rem 2rem;
    }

    .approach-card__icon {
      width: 70px;
      height: 70px;
    }

    .approach-card__icon svg {
      width: 35px;
      height: 35px;
    }
  }
</style>


