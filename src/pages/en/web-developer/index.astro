---
import Layout from "../../../layouts/PortfolioLayout.astro";
import Header from "../../../components/PortfolioHeader.astro";
import Footer from "../../../components/PortfolioFooter.astro";
import ProjectDevCard from "../../../components/ProjectDevCard.astro";
import SkillIcon from "../../../components/SkillIcon.astro";
---

<Layout
  title="Armando Ochoa - WD"
  description="Portfolio de Desarrollador Web - Armando Ochoa"
  favicon="💻"
>
  <Header currentPath="/en/web-developer" />

  <section class="home-hero">
    <div class="home-hero__content">
      <h1 class="heading-primary">HI, I'M ARMANDO OCHOA</h1>
      <div class="home-hero__info">
        <p class="text-primary">
          Full Stack Web Developer passionate about creating intuitive and functional
          digital experiences. I specialize in building modern, optimized, and scalable
          web applications that solve real problems and improve users' lives.
        </p>
      </div>
    </div>

    <div class="home-hero__mouse-scroll-cont">
      <div class="mouse"></div>
    </div>
  </section>

  <section id="about" class="about sec-pad">
    <div class="main-container">
      <h2 class="heading heading-sec heading-sec__mb-med">
        <span class="heading-sec__main">About Me</span>
        <span class="heading-sec__sub">
          Here you'll find more information about me, what I do, and my
          skills.
        </span>
      </h2>
      <div class="about__content">
        <div class="about__content-main">
          <h3 class="about__content-title">Get to know me!</h3>
          <div class="about__content-details">
            <p class="about__content-details-para">
              I'm a <strong>Full Stack Web Developer</strong> with a passion for creating
              innovative digital solutions that make a difference. I specialize in
              developing modern, responsive, and optimized web applications,
              using the latest technologies and industry best practices.
              <br />
              <br />
              My experience ranges from designing attractive user interfaces
              to implementing robust backend architectures. I've worked
              with technologies like Angular, React, JavaScript/TypeScript, and various
              frameworks that allow me to build complete and scalable web experiences.
              <br />
              <br />
              I'm motivated by solving complex problems through clean and efficient code.
              I firmly believe in the importance of user experience and
              agile development. My goal is to keep learning and constantly improving
              to create digital products that not only work well but also
              delight those who use them.
            </p>
          </div>
          <a href="../#contact" class="btn btn--med btn--theme dynamicBgClr"
            >Contact</a
          >
        </div>
        <div class="about__content-skills">
          <h3 class="about__content-title">My Skills</h3>
          <div class="skills-grid">
            <SkillIcon name="Angular" icon="simple-icons:angular" />
            <SkillIcon name="React" icon="simple-icons:react" />
            <SkillIcon name="Astro" icon="simple-icons:astro" />
            <SkillIcon name="Next.js" icon="simple-icons:nextdotjs" />
            <SkillIcon name="JavaScript" icon="simple-icons:javascript" />
            <SkillIcon name="TypeScript" icon="simple-icons:typescript" />
            <SkillIcon name="HTML5" icon="simple-icons:html5" />
            <SkillIcon name="CSS3" icon="simple-icons:css3" />
            <SkillIcon name="Node.js" icon="simple-icons:nodedotjs" />
            <SkillIcon name="Java" icon="simple-icons:openjdk" />
            <SkillIcon name="Spring" icon="simple-icons:spring" />
            <SkillIcon name="PostgreSQL" icon="simple-icons:postgresql" />
            <SkillIcon name="Git" icon="simple-icons:git" />
            <SkillIcon name="Tailwind" icon="simple-icons:tailwindcss" />
            <SkillIcon name="Sass" icon="simple-icons:sass" />
            <SkillIcon name="OpenShift" icon="simple-icons:redhatopenshift" />
          </div>
        </div>
      </div>
    </div>
  </section>

  <section id="projects" class="projects sec-pad">
    <div class="main-container">
      <h2 class="heading heading-sec heading-sec__mb-bg">
        <span class="heading-sec__main">Projects</span>
        <span class="heading-sec__sub">
          Here you can find some of the projects I've worked on.
        </span>
      </h2>

      <div class="projects-grid">
        <ProjectDevCard
          title="My Portfolio"
          description="Personal portfolio built with Astro and deployed with GitHub Pages. Designed to be fast, responsive, and showcase my skills."
          link="https://github.com/Armando8a-dev/mi-portafolio"
          tags={["Astro", "JavaScript", "CSS"]}
          lang="en"
          image="/thumbs/mi-portafolio-ss.png"
        />
        
        <ProjectDevCard
          title="Wedding Invitation"
          description="Interactive digital wedding invitation. A modern alternative to share event details such as date, location, and RSVP. Built with React for a smooth and attractive user experience."
          link="https://invitation-wedding-ui.netlify.app"
          tags={["React", "JavaScript", "Tailwind CSS"]}
          lang="en"
          image="/thumbs/invitacion-ss.png"
        />
        
        <ProjectDevCard
          title="Landing Kit"
          description="Customizable web template for independent professionals, focused on speed, responsive design, and ease of implementation."
          link="https://landing-fisio-ui.netlify.app"
          tags={["Next.js", "Tailwind CSS", "shadcn/ui"]}
          lang="en"
          image="/thumbs/landing-kit-ss.png"
        />
      </div>
    </div>
  </section>

  <section id="contact" class="contact sec-pad dynamicBg">
    <div class="main-container">
      <h2 class="heading heading-sec heading-sec__mb-med">
        <span class="heading-sec__main heading-sec__main--lt">Contact</span>
        <span class="heading-sec__sub heading-sec__sub--lt">
          Have any questions or want to work together? Fill out the
          form and I'll get back to you as soon as possible.
        </span>
      </h2>
      <div class="contact__form-container">
        <form
          action="https://formspree.io/f/mblzlndn"
          method="POST"
          class="contact__form"
        >
          <div class="contact__form-field">
            <label class="contact__form-label" for="name">Name</label>
            <input
              required
              placeholder="Enter Your Name"
              type="text"
              class="contact__form-input"
              name="name"
              id="name"
            />
          </div>
          <div class="contact__form-field">
            <label class="contact__form-label" for="email">Email</label>
            <input
              required
              placeholder="Enter Your Email"
              type="text"
              class="contact__form-input"
              name="email"
              id="email"
            />
          </div>
          <div class="contact__form-field">
            <label class="contact__form-label" for="message">Message</label>
            <textarea
              required
              cols="30"
              rows="10"
              class="contact__form-input"
              placeholder="Enter Your Message"
              name="message"
              id="message"></textarea>
          </div>
          <button type="submit" class="btn btn--theme contact__btn">
            Send Message
          </button>
        </form>
      </div>
    </div>
  </section>

  <Footer lang="en" profession="web" />
</Layout>

<style>
  /* Carrusel móvil */
  .projects-grid {
    display: flex;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    gap: 1.5rem;
    margin-top: 4rem;
    padding: 0 1.5rem 2rem;
    -webkit-overflow-scrolling: touch;
    scrollbar-width: none; /* Firefox */
    -ms-overflow-style: none; /* IE and Edge */
  }

  /* Ocultar scrollbar */
  .projects-grid::-webkit-scrollbar {
    display: none; /* Chrome, Safari and Opera */
  }

  .projects-grid > :global(*) {
    flex: 0 0 85%;
    scroll-snap-align: center;
  }

  @media (min-width: 768px) {
    .projects-grid {
      display: grid;
      grid-template-columns: repeat(2, 1fr);
      gap: 2.5rem;
      overflow-x: visible;
      scroll-snap-type: none;
      padding: 0;
    }

    .projects-grid > :global(*) {
      flex: unset;
      scroll-snap-align: unset;
    }
  }

  @media (min-width: 1024px) {
    .projects-grid {
      grid-template-columns: repeat(3, 1fr);
      gap: 3rem;
    }
  }
</style>
